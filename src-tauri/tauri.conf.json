{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SignLens",
  "version": "0.1.0",
  "identifier": "com.signlens.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SignLens",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/JmDemisana/SignLens/releases/latest/download/latest.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyNEU1NzlCNTI3OUMxN0EKUldSNndYbFNtMWRPY3ZMd3p5S1lsT1JxeEx4UXJ0UnZvYVIxd2hCbUdCY1ROU1pMTVBiV3dsa3kK"
    }
  }
}
